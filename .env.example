# CampusOne Environment Variables Example
# Duplicate this file as .env inside the backend directory: backend/.env
# Replace the placeholder values with your local settings.

# PostgreSQL 18 Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=campusone_db

# Security & Tokens
# Generate a secure random string for production
SECRET_KEY=campusone-super-secret-production-key-2024-change-in-prod-xyz987
ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_TOKEN_EXPIRE_MINUTES=30

# File Uploads Directory
UPLOAD_DIR=uploads
