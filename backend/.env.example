# CampusOne Backend Environment Variables Example
# Copy this file to .env in this directory and fill in your PostgreSQL password.

# PostgreSQL 18 Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=campusone_db

# Security & Tokens
SECRET_KEY=campusone-super-secret-production-key-2024-change-in-prod-xyz987
ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_TOKEN_EXPIRE_MINUTES=30

# File Uploads Directory
UPLOAD_DIR=uploads
